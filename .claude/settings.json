{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__t3-code__(pull_request_(create|update|respond|review|merge)|create_issue|comment_on_issue)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/private_terms_guard.sh",
            "timeout": 30,
            "statusMessage": "Checking for private terms"
          }
        ]
      }
    ]
  }
}
